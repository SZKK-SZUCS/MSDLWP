{
    "name": "msdl/msdl-child",
    "description": "MSDL Child - SharePoint/OneDrive dokumentumtar kliens",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpstan/phpstan": "^1.11",
        "szepeviktor/phpstan-wordpress": "^1.3"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "stan": "phpstan analyse --memory-limit=3G",
        "stan:baseline": "phpstan analyse --memory-limit=3G --generate-baseline"
    }
}
